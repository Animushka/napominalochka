# Copy to .env. Do not commit real tokens.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
WEB_APP_URL=https://reminders.example.com
WEB_LISTEN=0.0.0.0:8080
DATABASE_PATH=data/napominalochka.db
RUST_LOG=info
# Optional diagnostics; disabled by default.
SENTRY_DSN=

# Optional official Yandex Smart Home integration. Leave all three empty to disable.
# Register a Yandex OAuth web app with iot:view and iot:control permissions.
# Redirect URI: ${WEB_APP_URL}/integrations/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Generate a persistent 32-byte encryption key: openssl rand -hex 32
# Back up this key securely with the database; replacing it requires users to reconnect.
YANDEX_TOKEN_KEY=
